// Lab 08: Infrastructure as Code pipeline (job แยก petpaws-infra)
// Lint -> Security Scan -> Plan -> อนุมัติโดยคน -> Apply -> Ansible   หรือ   Plan destroy -> อนุมัติ -> Destroy
pipeline {
    agent none

    parameters {
        choice(name: 'ACTION', choices: ['apply', 'destroy'],
               description: 'apply = สร้าง/อัปเดตสภาพแวดล้อม, destroy = ลบทุกอย่างที่ Terraform สร้าง')
    }

    environment {
        // credential จำลองของ LocalStack (ไม่ใช่บัญชี AWS จริง) LocalStack รับค่าอะไรก็ได้
        AWS_ACCESS_KEY_ID = 'localstack'
        AWS_SECRET_ACCESS_KEY = 'localstack'
        AWS_DEFAULT_REGION = 'ap-southeast-1'
        TF_IN_AUTOMATION = 'true'
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        // ทุก stage รันบน linux-build ใน workspace เดียวกัน ดึงโค้ดครั้งเดียวพอ (เน็ตในแลปหลุดบ่อย)
        skipDefaultCheckout(true)
        // ห้ามรันซ้อน: state มีได้ทีละคนแก้ (DynamoDB lock ก็กันไว้อีกชั้น)
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            agent { label 'linux-build' }
            steps {
                retry(3) {
                    checkout scm
                }
            }
        }

        stage('IaC') {
            agent {
                docker {
                    image 'petpaws-iac:1'
                    label 'linux-build'
                    // network jenkins: คุยกับ LocalStack และเครื่องที่ Terraform สร้าง
                    // docker.sock: provider docker ของ Terraform สร้าง container บนเครื่องแม่
                    args '--network jenkins -v /var/run/docker.sock:/var/run/docker.sock --group-add 0'
                }
            }
            environment {
                HOME = "${WORKSPACE}"
                // เก็บ provider ที่ดาวน์โหลดแล้วไว้ใน workspace ไม่ต้องโหลดใหม่ทุก build
                TF_PLUGIN_CACHE_DIR = "${WORKSPACE}/.terraform-plugin-cache"
            }
            stages {
                stage('Remote State Bootstrap') {
                    steps {
                        // สร้าง bucket เก็บ state และตาราง lock ถ้ายังไม่มี (รันซ้ำได้ไม่พัง)
                        sh '''
                            mkdir -p "$TF_PLUGIN_CACHE_DIR" reports
                            AWS="aws --endpoint-url http://localstack:4566"
                            $AWS s3api head-bucket --bucket petpaws-tfstate 2>/dev/null \
                              || $AWS s3api create-bucket --bucket petpaws-tfstate \
                                   --create-bucket-configuration LocationConstraint=$AWS_DEFAULT_REGION
                            $AWS s3api put-bucket-versioning --bucket petpaws-tfstate \
                              --versioning-configuration Status=Enabled
                            $AWS dynamodb describe-table --table-name petpaws-tflock >/dev/null 2>&1 \
                              || $AWS dynamodb create-table --table-name petpaws-tflock \
                                   --attribute-definitions AttributeName=LockID,AttributeType=S \
                                   --key-schema AttributeName=LockID,KeyType=HASH \
                                   --billing-mode PAY_PER_REQUEST
                        '''
                    }
                }

                stage('IaC Lint & Validate') {
                    parallel {
                        stage('Terraform Validate') {
                            steps {
                                dir('infra/terraform') {
                                    retry(3) {
                                        sh 'terraform init -backend=false -input=false'
                                    }
                                    sh 'terraform validate'
                                    sh 'terraform fmt -check -recursive -diff'
                                }
                            }
                        }
                        stage('Ansible Lint') {
                            steps {
                                dir('infra/ansible') {
                                    sh 'ansible-lint playbook.yml'
                                }
                            }
                        }
                    }
                }

                stage('IaC Security Scan') {
                    steps {
                        // tfsec เป็นตัวตัดสิน: พบระดับ HIGH ขึ้นไป -> หยุด pipeline
                        // checkov เก็บรายงานไว้ดูประกอบ (soft-fail) เพราะมีกฎที่ไม่เกี่ยวกับสภาพแวดล้อมจำลอง
                        // เช่น ต้องผูก IAM role หรือเปิด VPC flow log ซึ่ง LocalStack รุ่นฟรีไม่รองรับ
                        sh '''
                            tfsec infra/terraform --no-color --format lovely,json,sarif \
                              --out reports/tfsec --minimum-severity HIGH
                            checkov -d infra/terraform --framework terraform --compact --quiet \
                              --soft-fail -o cli -o json --output-file-path console,reports/checkov
                        '''
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'reports/tfsec*, reports/checkov/**', allowEmptyArchive: true
                        }
                    }
                }

                stage('Terraform Plan') {
                    steps {
                        dir('infra/terraform') {
                            retry(3) {
                                sh 'terraform init -input=false -reconfigure'
                            }
                            script {
                                def destroyFlag = params.ACTION == 'destroy' ? '-destroy' : ''
                                sh "terraform plan -input=false ${destroyFlag} -out=tfplan"
                            }
                            sh 'terraform show -no-color tfplan > tfplan.txt'
                            script {
                                env.PLAN_SUMMARY = sh(script: "grep -E '^Plan:|No changes' tfplan.txt || true",
                                                      returnStdout: true).trim()
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'infra/terraform/tfplan, infra/terraform/tfplan.txt', allowEmptyArchive: true
                        }
                    }
                }
            }
        }

        // อยู่นอก stage ที่มี agent: ระหว่างรอคนกดอนุมัติจะไม่ยึด executor ของ linux-build ไว้
        stage('Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "${params.ACTION.toUpperCase()}: ${env.PLAN_SUMMARY} ตรวจไฟล์ tfplan.txt แล้วยืนยันหรือไม่?",
                          ok: "Yes, ${params.ACTION}"
                }
            }
        }

        stage('Apply') {
            agent {
                docker {
                    image 'petpaws-iac:1'
                    label 'linux-build'
                    args '--network jenkins -v /var/run/docker.sock:/var/run/docker.sock --group-add 0'
                }
            }
            environment {
                HOME = "${WORKSPACE}"
                TF_PLUGIN_CACHE_DIR = "${WORKSPACE}/.terraform-plugin-cache"
                ANSIBLE_HOST_KEY_CHECKING = 'False'
                ANSIBLE_KEY_FILE = "${WORKSPACE}/infra/ansible/ansible_key"
            }
            stages {
                stage('Terraform Apply') {
                    steps {
                        dir('infra/terraform') {
                            // apply ไฟล์ plan ที่ผ่านการอนุมัติเท่านั้น ไม่ plan ใหม่ ของที่ถูกสร้างจึงตรงกับที่คนตรวจ
                            sh 'terraform apply -input=false tfplan'
                            sh 'terraform output'
                        }
                    }
                }
                stage('Ansible Configure') {
                    when { expression { params.ACTION == 'apply' } }
                    steps {
                        dir('infra/ansible') {
                            sh '''
                                terraform -chdir=../terraform output -raw ssh_private_key > "$ANSIBLE_KEY_FILE"
                                chmod 600 "$ANSIBLE_KEY_FILE"
                                chmod +x tf_inventory.py
                                echo "--- dynamic inventory from terraform output ---"
                                ./tf_inventory.py --list
                                # รอ sshd ในเครื่องใหม่เปิดพร้อม
                                ansible app -i tf_inventory.py -m ansible.builtin.wait_for_connection -a timeout=60
                                ansible-playbook -i tf_inventory.py playbook.yml
                            '''
                        }
                    }
                    post {
                        always {
                            sh 'rm -f infra/ansible/ansible_key'
                        }
                    }
                }
                stage('Verify Destroy') {
                    when { expression { params.ACTION == 'destroy' } }
                    steps {
                        dir('infra/terraform') {
                            // state ต้องว่างหลัง destroy = ไม่มีรีซอร์สค้าง
                            sh '''
                                LEFT=$(terraform state list | wc -l)
                                terraform state list || true
                                echo "resources left in state: $LEFT"
                                test "$LEFT" -eq 0
                            '''
                        }
                    }
                }
            }
        }
    }
}
