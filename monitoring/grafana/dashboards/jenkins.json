{
  "uid": "petpaws-jenkins",
  "title": "PetPaws Jenkins Pipeline",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Build Success Rate",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum({__name__=~\"default_jenkins_builds_success_build_count(_total)?\"}) / (sum({__name__=~\"default_jenkins_builds_success_build_count(_total)?\"}) + sum({__name__=~\"default_jenkins_builds_failed_build_count(_total)?\"}))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 Build Duration",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 360 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(default_jenkins_builds_duration_milliseconds_summary{quantile=\"0.95\"}) / 1000"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Current Queue Length",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 } },
      "targets": [
        { "refId": "A", "expr": "jenkins_queue_size_value", "legendFormat": "queue" }
      ]
    }
  ]
}
